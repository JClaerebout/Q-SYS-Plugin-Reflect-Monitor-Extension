BuildVersion = "1.1.0.0"
PluginInfo = {
  Name = "Monitoring~Reflect Monitor Extension v" .. BuildVersion, -- preferred format is "manufacturer~plugin name version"
  Version = BuildVersion,
  Id = "25e1094b-2862-474e-bad6-5e91bbbfc49a",
  Description = [[Monitor selected controls through a Q-SYS Monitoring Proxy or directly on a Reflect Ready component.]],
  Author = "Jens Claerebout",
  ShowDebug = true
}

function controlCount(props)
  return math.max(1, math.min(32, math.floor(tonumber(props["Number of Controls"].Value) or 1)))
end

function isReflectReady(props)
  return props["Reflect Ready"] ~= nil and props["Reflect Ready"].Value == true
end

function compromisedSeverity(value)
  return value == "error" and "error" or "warning"
end

function GetProperties()
  return {
    {
      Name = "Number of Controls",
      Type = "integer",
      Value = 1,
      Min = 1,
      Max = 32
    },
    {
      Name = "Reflect Ready",
      Type = "boolean",
      Value = false
    }
  }
end

function RectifyProperties(props)
  props["Number of Controls"].Value = controlCount(props)
  return props
end

function GetPrettyName(props)
  return "Reflect Monitor Extension v" .. PluginInfo.Version
end

function GetColor(props)
  return { 112, 190, 18 }
end

function GetControls(props)
  GetControls_count = controlCount(props)
  return {
    {
      Name = "Status",
      ControlType = "Indicator",
      IndicatorType = "Status",
      Count = 1,
      UserPin = false
    },
    {
      Name = "Component",
      ControlType = "Text",
      Count = 1,
      UserPin = false
    },
    {
      Name = "Monitor",
      ControlType = "Text",
      Count = 1,
      UserPin = false
    },
    {
      Name = "Lock",
      ControlType = "Button",
      ButtonType = "Toggle",
      Count = 1,
      UserPin = false,
      Icon = "Lock"
    },
    {
      Name = "Control",
      ControlType = "Text",
      Count = GetControls_count,
      UserPin = false
    },
    {
      Name = "Alias",
      ControlType = "Text",
      Count = GetControls_count,
      UserPin = false
    },
    {
      Name = "Value",
      ControlType = "Indicator",
      IndicatorType = "Text",
      Count = GetControls_count,
      UserPin = true,
      PinStyle = "Output"
    },
    {
      Name = "LogEntry",
      ControlType = "Text",
      Count = GetControls_count,
      UserPin = false
    },
    {
      Name = "NormalLogEntry",
      ControlType = "Text",
      Count = GetControls_count,
      UserPin = false
    },
    {
      Name = "Severity",
      ControlType = "Text",
      Count = GetControls_count,
      UserPin = false
    }
  }
end

function GetPages(props)
  return { { name = "Controls" } }
end

function GetControlLayout(props)
  GetControlLayout_layout = {}
  GetControlLayout_graphics = {}
  GetControlLayout_count = controlCount(props)
  GetControlLayout_rowHeight = 29
  GetControlLayout_rowGap = 5
  GetControlLayout_reflectReady = isReflectReady(props)
  GetControlLayout_firstRowY = GetControlLayout_reflectReady and 151 or 192
  GetControlLayout_statusY = GetControlLayout_reflectReady and 68 or 109
  GetControlLayout_headerY = GetControlLayout_firstRowY - 38
  GetControlLayout_panelHeight = GetControlLayout_firstRowY + GetControlLayout_count * (GetControlLayout_rowHeight + GetControlLayout_rowGap) + 18

  function arrayName(name, index)
    return GetControlLayout_count == 1 and name or name .. " " .. index
  end

  function addLabel(text, x, y, width, height, align, size)
    table.insert(GetControlLayout_graphics, {
      Type = "Label",
      Text = text,
      Position = { x, y },
      Size = { width, height },
      TextSize = size or 14,
      HTextAlign = align or "Left",
      VTextAlign = "Center"
    })
  end

  table.insert(GetControlLayout_graphics, {
    Type = "GroupBox",
    Position = { 10, 10 },
    Size = { GetControlLayout_reflectReady and 940 or 1240, GetControlLayout_panelHeight - 10 },
    StrokeWidth = 1,
    CornerRadius = 8
  })

  addLabel("Component/Plugin", 35, 27, 145, 31, "Left", 15)
  if not GetControlLayout_reflectReady then
    addLabel("Monitoring Proxy", 35, 68, 145, 31, "Left", 15)
  end
  addLabel("Status", 35, GetControlLayout_statusY, 145, 31, "Left", 15)

  GetControlLayout_layout.Status = {
    PrettyName = "Status",
    Position = { 180, GetControlLayout_statusY },
    Size = { 650, 31 },
    Style = "Text",
    TextFontSize = 14
  }

  GetControlLayout_layout.Component = {
    PrettyName = "Component/Plugin",
    Position = { 180, 27 },
    Size = { 650, 31 },
    Style = "ComboBox",
    TextFontSize = 14
  }

  if not GetControlLayout_reflectReady then
    GetControlLayout_layout.Monitor = {
      PrettyName = "Monitoring Proxy",
      Position = { 180, 68 },
      Size = { 650, 31 },
      Style = "ComboBox",
      TextFontSize = 14
    }
  end

  GetControlLayout_layout.Lock = {
    PrettyName = "Lock Configuration",
    Position = { 855, 28 },
    Size = { 70, 70 },
    Style = "Button",
    TextFontSize = 12
  }

  addLabel("Control", 40, GetControlLayout_headerY, 185, 28, "Center", 15)
  addLabel("Alias", 225, GetControlLayout_headerY, 180, 28, "Center", 15)
  addLabel("Value", 405, GetControlLayout_headerY, 125, 28, "Center", 15)
  if not GetControlLayout_reflectReady then
    addLabel("Compromised Log Entry", 530, GetControlLayout_headerY, 300, 28, "Center", 15)
    addLabel("Back to Normal Log Entry", 830, GetControlLayout_headerY, 300, 28, "Center", 15)
    addLabel("Severity", 1130, GetControlLayout_headerY, 105, 28, "Center", 15)
  end

  for index = 1, GetControlLayout_count do
    GetControlLayout_y = GetControlLayout_firstRowY + (index - 1) * (GetControlLayout_rowHeight + GetControlLayout_rowGap)
    GetControlLayout_suffix = "~" .. tostring(index)

    GetControlLayout_layout[arrayName("Control", index)] = {
      PrettyName = "Control" .. GetControlLayout_suffix,
      Position = { 40, GetControlLayout_y },
      Size = { 185, GetControlLayout_rowHeight },
      Style = "ComboBox",
      TextFontSize = 12
    }
    GetControlLayout_layout[arrayName("Alias", index)] = {
      PrettyName = "Alias" .. GetControlLayout_suffix,
      Position = { 225, GetControlLayout_y },
      Size = { 180, GetControlLayout_rowHeight },
      Style = "Text",
      TextFontSize = 12
    }
    GetControlLayout_layout[arrayName("Value", index)] = {
      PrettyName = "Value" .. GetControlLayout_suffix,
      Position = { 405, GetControlLayout_y },
      Size = { 125, GetControlLayout_rowHeight },
      Style = "Text",
      TextFontSize = 12
    }
    if not GetControlLayout_reflectReady then
      GetControlLayout_layout[arrayName("LogEntry", index)] = {
        PrettyName = "Compromised Log Entry" .. GetControlLayout_suffix,
        Position = { 530, GetControlLayout_y },
        Size = { 300, GetControlLayout_rowHeight },
        Style = "Text",
        TextFontSize = 12
      }
      GetControlLayout_layout[arrayName("NormalLogEntry", index)] = {
        PrettyName = "Back to Normal Log Entry" .. GetControlLayout_suffix,
        Position = { 830, GetControlLayout_y },
        Size = { 300, GetControlLayout_rowHeight },
        Style = "Text",
        TextFontSize = 12
      }
      GetControlLayout_layout[arrayName("Severity", index)] = {
        PrettyName = "Severity" .. GetControlLayout_suffix,
        Position = { 1130, GetControlLayout_y },
        Size = { 105, GetControlLayout_rowHeight },
        Style = "ComboBox",
        TextFontSize = 12
      }
    end
  end

  -- Keep both layouts and all row counts at the same compact scale.
  function compact(item)
    for _, key in ipairs({ "Position", "Size" }) do
      if item[key] then
        for axis = 1, 2 do
          item[key][axis] = math.floor(item[key][axis] * 0.8 + 0.5)
        end
      end
    end
    for _, key in ipairs({ "TextSize", "TextFontSize" }) do
      if item[key] then
        item[key] = math.max(10, math.floor(item[key] * 0.8 + 0.5))
      end
    end
  end

  for _, item in pairs(GetControlLayout_layout) do compact(item) end
  for _, item in ipairs(GetControlLayout_graphics) do compact(item) end

  return GetControlLayout_layout, GetControlLayout_graphics
end

if Controls then

-- Monitor selected controls on any Q-SYS component or plugin with Script Access through a Monitoring Proxy.

-- Q-SYS exposes a Count of one as a single control, while this runtime uses
-- arrays for its repeated rows. Wrap only the repeated controls so the full
-- 1-32 property range behaves consistently.
qsysControls = Controls
repeatedControlNames = {
  Control = true,
  Alias = true,
  Value = true,
  LogEntry = true,
  NormalLogEntry = true,
  Severity = true
}
configuredControlCount = math.max(
  1,
  math.floor(tonumber(Properties["Number of Controls"].Value) or 6)
)
runtimeControls = setmetatable({}, {
  __index = function(_, name)
    callback_control = qsysControls[name]
    if configuredControlCount == 1 and repeatedControlNames[name] then
      return { callback_control }
    end
    return callback_control
  end
})

STATE_FILE_PREFIX = "media/Mon Proxy Extension State - "
reflectReady = isReflectReady(Properties)
nativeStatusValue = 0
nativeStatusText = "OK"
lastDirectStatusValue = nil
lastDirectStatusText = nil
COLOR_OK = "#00A651"
COLOR_CHANGED = "#F5A000"
COLOR_LOCKED = "#D32F2F"
COLOR_UNLOCKED = "#00A651"

sourceComponent = nil
monitorComponent = nil
sourceControls = {}
sourceControlNames = {}
sourceStatus = nil
sourceStatusReadOnly = false
baseline = {}
reportedChanges = {}
lockedComponentName = ""
lockedMonitorName = ""
changingControl = false
updatingMonitorStatus = false
desiredMonitorStatusValue = 0
desiredMonitorStatusMessage = "OK"
missingCorrectionCount = 0

evaluateMonitoring = nil

function stateFilePath()
  -- A Monitoring Proxy Code Name is unique within a design, making it a
  -- stable namespace for the extension instance that owns that proxy.
  stateFilePath_monitorName = lockedMonitorName
  if stateFilePath_monitorName == "" and runtimeControls.Monitor then
    stateFilePath_monitorName = runtimeControls.Monitor.String
  end
  if reflectReady then
    stateFilePath_monitorName = lockedComponentName ~= "" and lockedComponentName or runtimeControls.Component.String
    if stateFilePath_monitorName == "" then return nil end
    stateFilePath_monitorName = "Reflect Ready - " .. stateFilePath_monitorName
  end
  if stateFilePath_monitorName == "" then return nil end

  stateFilePath_hash = 0
  for index = 1, #stateFilePath_monitorName do
    stateFilePath_hash = (stateFilePath_hash * 31 + stateFilePath_monitorName:byte(index)) % 4294967296
  end

  stateFilePath_safeName = stateFilePath_monitorName
    :gsub("[^%w%-%._ ]", "_")
    :gsub("^%s+", "")
    :gsub("%s+$", "")
    :sub(1, 48)
  if stateFilePath_safeName == "" then stateFilePath_safeName = "Monitor" end

  return string.format("%s%s-%08x.txt", STATE_FILE_PREFIX, stateFilePath_safeName, stateFilePath_hash)
end

function logError(context, err)
  print(string.format("%s: %s", context, tostring(err)))
end

function escapeField(value)
  escapeField_text = tostring(value or "")
  escapeField_text = escapeField_text:gsub("\\", "\\\\")
  escapeField_text = escapeField_text:gsub("\t", "\\t")
  escapeField_text = escapeField_text:gsub("\r", "\\r")
  escapeField_text = escapeField_text:gsub("\n", "\\n")
  return escapeField_text
end

function unescapeField(value)
  return (tostring(value or ""):gsub("\\(.)", function(character)
    if character == "t" then return "\t" end
    if character == "r" then return "\r" end
    if character == "n" then return "\n" end
    return character
  end))
end

function controlText(control)
  if not control then return "" end

  controlText_ok, controlText_value = pcall(function() return control.String end)
  if controlText_ok and controlText_value ~= nil then return tostring(controlText_value) end

  controlText_ok, controlText_value = pcall(function() return control.Value end)
  if controlText_ok and controlText_value ~= nil then return tostring(controlText_value) end

  return ""
end

function controlValue(control)
  if not control then return nil end
  controlValue_ok, controlValue_value = pcall(function() return control.Value end)
  if controlValue_ok then return controlValue_value end
  return nil
end


function setValueColor(control, color)
  pcall(function() control.Color = color end)
end

function setMonitorStatus(value, message, allowMissing)
  setMonitorStatus_requestedValue = tonumber(value) or 0
  print(string.format(
    "[Monitor Debug] status request: value=%s, message=%q, allowMissing=%s",
    tostring(setMonitorStatus_requestedValue), tostring(message or ""), tostring(allowMissing == true)
  ))
  if setMonitorStatus_requestedValue == 4 and not allowMissing then
    print("Blocked unexpected Monitoring Proxy Missing status")
    setMonitorStatus_requestedValue = 1
  end

  setMonitorStatus_requestedMessage = tostring(message or "")
  runtimeControls.Status.Value = setMonitorStatus_requestedValue
  runtimeControls.Status.String = setMonitorStatus_requestedMessage

  if reflectReady then
    if sourceStatusReadOnly then
      runtimeControls.Status.Value = 1
      runtimeControls.Status.String = "Status is read-only; disable Reflect Ready and use a Monitoring Proxy"
      return
    end
    if not sourceStatus then
      runtimeControls.Status.Value = 1
      runtimeControls.Status.String = sourceComponent
        and "Selected component has no Status control" or "Selected component is unavailable"
      return
    end
    if tonumber(controlValue(sourceStatus)) == setMonitorStatus_requestedValue
      and controlText(sourceStatus) == setMonitorStatus_requestedMessage then return end
    lastDirectStatusValue = setMonitorStatus_requestedValue
    lastDirectStatusText = setMonitorStatus_requestedMessage
    updatingMonitorStatus = true
    setMonitorStatus_ok, setMonitorStatus_err = pcall(function()
      sourceStatus.Value = setMonitorStatus_requestedValue
      sourceStatus.String = setMonitorStatus_requestedMessage
    end)
    updatingMonitorStatus = false
    if not setMonitorStatus_ok then
      lastDirectStatusValue = nil
      lastDirectStatusText = nil
      runtimeControls.Status.Value = 1
      runtimeControls.Status.String = "Unable to update selected component status"
      logError(runtimeControls.Status.String, setMonitorStatus_err)
    end
    return
  end

  if not monitorComponent then
    runtimeControls.Status.Value = 1
    runtimeControls.Status.String = runtimeControls.Monitor.String == ""
      and "Select a Monitoring Proxy" or "Selected Monitoring Proxy is unavailable"
    return
  end

  setMonitorStatus_targetStatus = monitorComponent["status"]
  if not setMonitorStatus_targetStatus then
    runtimeControls.Status.Value = 1
    runtimeControls.Status.String = "Selected Monitoring Proxy has no 'status' control"
    print(runtimeControls.Status.String)
    return
  end

  desiredMonitorStatusValue = setMonitorStatus_requestedValue
  desiredMonitorStatusMessage = setMonitorStatus_requestedMessage
  setMonitorStatus_currentValue = tonumber(controlValue(setMonitorStatus_targetStatus))
  setMonitorStatus_currentText = controlText(setMonitorStatus_targetStatus)
  setMonitorStatus_messageMatches = setMonitorStatus_requestedMessage == ""
    or setMonitorStatus_currentText == setMonitorStatus_requestedMessage
    or setMonitorStatus_currentText:sub(-#setMonitorStatus_requestedMessage) == setMonitorStatus_requestedMessage

  if setMonitorStatus_currentValue == setMonitorStatus_requestedValue and setMonitorStatus_messageMatches then
    print("[Monitor Debug] target already matches request; skipping write")
    return
  end

  updatingMonitorStatus = true
  setMonitorStatus_ok2, setMonitorStatus_err2 = pcall(function()
    print(string.format(
      "[Monitor Debug] target before write: value=%s, string=%q",
      tostring(setMonitorStatus_targetStatus.Value), controlText(setMonitorStatus_targetStatus)
    ))

    setMonitorStatus_targetStatus.Value = setMonitorStatus_requestedValue
    print(string.format(
      "[Monitor Debug] target after Value: value=%s, string=%q",
      tostring(setMonitorStatus_targetStatus.Value), controlText(setMonitorStatus_targetStatus)
    ))

    setMonitorStatus_targetStatus.String = setMonitorStatus_requestedMessage
    print(string.format(
      "[Monitor Debug] target after String: value=%s, string=%q",
      tostring(setMonitorStatus_targetStatus.Value), controlText(setMonitorStatus_targetStatus)
    ))

    -- Some Monitoring Proxy versions can reinterpret a reason update. Never
    -- leave it at Missing unless that state came from the source Status control.
    if setMonitorStatus_requestedValue ~= 4 and tonumber(setMonitorStatus_targetStatus.Value) == 4 then
      print("Monitoring Proxy changed to Missing while setting status; restoring requested state")
      setMonitorStatus_targetStatus.Value = setMonitorStatus_requestedValue
      print(string.format(
        "[Monitor Debug] target after restore: value=%s, string=%q",
        tostring(setMonitorStatus_targetStatus.Value), controlText(setMonitorStatus_targetStatus)
      ))
    end
  end)
  updatingMonitorStatus = false
  if not setMonitorStatus_ok2 then
    runtimeControls.Status.Value = 1
    runtimeControls.Status.String = "Unable to update Monitoring Proxy status"
    logError("Unable to update Monitoring Proxy status", setMonitorStatus_err2)
  end
end

function monitorStatusChanged(control)
  monitorStatusChanged_actualValue = tonumber(controlValue(control))
  monitorStatusChanged_actualText = controlText(control)
  monitorStatusChanged_sourceValue = tonumber(controlValue(sourceStatus))

  print(string.format(
    "[Monitor Debug] proxy status event: value=%s, string=%q, duringWrite=%s, sourceStatus=%s",
    tostring(monitorStatusChanged_actualValue), monitorStatusChanged_actualText, tostring(updatingMonitorStatus), tostring(monitorStatusChanged_sourceValue)
  ))

  if updatingMonitorStatus then return end

  monitorStatusChanged_sourceReportsMissing = sourceStatus ~= nil and monitorStatusChanged_sourceValue == 4
  if monitorStatusChanged_actualValue == 4 and not monitorStatusChanged_sourceReportsMissing and desiredMonitorStatusValue ~= 4 then
    if missingCorrectionCount >= 3 then
      print("[Monitor Debug] repeated asynchronous Missing states; automatic correction paused")
      return
    end

    missingCorrectionCount = missingCorrectionCount + 1
    Timer.CallAfter(function() missingCorrectionCount = 0 end, 2)
    print(string.format(
      "[Monitor Debug] asynchronous Missing detected; restoring value=%s, message=%q",
      tostring(desiredMonitorStatusValue), desiredMonitorStatusMessage
    ))
    setMonitorStatus(desiredMonitorStatusValue, desiredMonitorStatusMessage, false)
  end
end

function sendMonitorLog(message, severity)
  if reflectReady then return end
  sendMonitorLog_target = monitorComponent
  if not sendMonitorLog_target then return end

  sendMonitorLog_targetLogEntry = sendMonitorLog_target["log.entry"]
  sendMonitorLog_targetSeverity = sendMonitorLog_target["severity"]
  sendMonitorLog_targetTrigger = sendMonitorLog_target["trigger"]
  if not sendMonitorLog_targetLogEntry or not sendMonitorLog_targetSeverity or not sendMonitorLog_targetTrigger then
    print("Monitoring target requires 'log.entry', 'severity', and 'trigger' controls for log entries")
    return
  end

  sendMonitorLog_ok, sendMonitorLog_err = pcall(function()
    sendMonitorLog_targetLogEntry.String = message or ""
    sendMonitorLog_targetSeverity.String = string.lower(severity or "normal")
    sendMonitorLog_targetTrigger:Trigger()
  end)
  if not sendMonitorLog_ok then logError("Unable to send Monitoring Proxy log entry", sendMonitorLog_err) end
end

function defaultLogEntry(name, control)
  if not name or name == "" then return "" end

  defaultLogEntry_value = controlText(control)
  if defaultLogEntry_value == "" then return name .. " changed." end

  return name .. " is no longer " .. defaultLogEntry_value .. "."
end

function controlDisplayName(index)
  controlDisplayName_alias = runtimeControls.Alias[index].String
  if controlDisplayName_alias ~= "" then return controlDisplayName_alias end

  controlDisplayName_name = runtimeControls.Control[index].String
  if controlDisplayName_name ~= "" then return controlDisplayName_name end

  return "Control " .. tostring(index)
end

function saveState(locked)
  saveState_path = stateFilePath()
  if not saveState_path then
    logError("Unable to save monitor state", reflectReady and "no component is selected" or "no Monitoring Proxy is selected")
    return false
  end

  saveState_file, saveState_err = io.open(saveState_path, "w")
  if not saveState_file then
    logError("Unable to save monitor state", saveState_err)
    return false
  end

  saveState_file:write("version\t4\n")
  saveState_file:write("locked\t", locked and "1" or "0", "\n")
  saveState_file:write("component\t", escapeField(lockedComponentName), "\n")
  saveState_file:write("monitor\t", escapeField(lockedMonitorName), "\n")

  for index = 1, #runtimeControls.Control do
    saveState_item = baseline[index] or {}
    saveState_file:write(
      "slot\t", tostring(index), "\t",
      escapeField(saveState_item.name), "\t",
      escapeField(saveState_item.value), "\t",
      escapeField(saveState_item.logEntry), "\t",
      escapeField(compromisedSeverity(saveState_item.severity)), "\t",
      escapeField(saveState_item.alias), "\t",
      escapeField(saveState_item.normalLogEntry), "\n"
    )
  end

  saveState_file:close()
  return true
end

function loadState()
  loadState_path = stateFilePath()
  if not loadState_path then return nil end

  loadState_file = io.open(loadState_path, "r")
  if not loadState_file then return nil end

  loadState_state = { locked = false, component = "", monitor = "", slots = {} }

  for line in loadState_file:lines() do
    loadState_key, loadState_rest = line:match("^([^\t]+)\t(.*)$")
    if loadState_key == "locked" then
      loadState_state.locked = loadState_rest == "1"
    elseif loadState_key == "component" then
      loadState_state.component = unescapeField(loadState_rest)
    elseif loadState_key == "monitor" then
      loadState_state.monitor = unescapeField(loadState_rest)
    elseif loadState_key == "slot" then
      loadState_index, loadState_name, loadState_value, loadState_logEntry, loadState_severity, loadState_alias, loadState_normalLogEntry =
        loadState_rest:match("^(%d+)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t(.*)$")
      if not loadState_index then
        loadState_index, loadState_name, loadState_value, loadState_logEntry, loadState_severity, loadState_alias =
          loadState_rest:match("^(%d+)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t(.*)$")
      end
      if not loadState_index then
        loadState_index, loadState_name, loadState_value, loadState_logEntry, loadState_severity =
          loadState_rest:match("^(%d+)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t(.*)$")
      end
      if not loadState_index then
        loadState_index, loadState_name, loadState_value = loadState_rest:match("^(%d+)\t([^\t]*)\t(.*)$")
      end
      loadState_index = tonumber(loadState_index)
      if loadState_index then
        loadState_state.slots[loadState_index] = {
          name = unescapeField(loadState_name),
          value = unescapeField(loadState_value),
          logEntry = unescapeField(loadState_logEntry),
          severity = compromisedSeverity(unescapeField(loadState_severity)),
          normalLogEntry = unescapeField(loadState_normalLogEntry),
          alias = unescapeField(loadState_alias)
        }
      end
    end
  end

  loadState_file:close()
  return loadState_state
end


function updateDisplayedValues()
  for index, selector in ipairs(runtimeControls.Control) do
    runtimeControls.Value[index].String = controlText(sourceControls[selector.String])
  end
end

function resetControlSlots()
  changingControl = true
  for index, selector in ipairs(runtimeControls.Control) do
    selector.String = ""
    runtimeControls.Value[index].String = ""
    runtimeControls.Alias[index].String = ""
    runtimeControls.LogEntry[index].String = ""
    runtimeControls.NormalLogEntry[index].String = ""
    runtimeControls.Severity[index].String = "warning"
    setValueColor(runtimeControls.Value[index], COLOR_OK)
  end
  changingControl = false
  baseline = {}
  reportedChanges = {}
end

function releaseSourceHandlers()
  if sourceStatus then pcall(function() sourceStatus.EventHandler = nil end) end
  for _, control in pairs(sourceControls) do
    pcall(function() control.EventHandler = nil end)
  end
end

function bindSourceHandlers()
  releaseSourceHandlers()
  bindSourceHandlers_boundControls = {}

  function bindHandler(name, control)
    if not control or bindSourceHandlers_boundControls[control] then return end
    bindSourceHandlers_boundControls[control] = true
    control.EventHandler = function()
      if reflectReady and control == sourceStatus then
        if updatingMonitorStatus then return end
        bindHandler_value, bindHandler_text = tonumber(controlValue(control)), controlText(control)
        -- Ignore our own status echo, including deferred events.
        if bindHandler_value == lastDirectStatusValue and bindHandler_text == lastDirectStatusText then return end
        nativeStatusValue, nativeStatusText = bindHandler_value or 0, bindHandler_text
      end
      evaluateMonitoring(name)
    end
  end

  bindHandler("Status", sourceStatus)
  for _, selector in ipairs(runtimeControls.Control) do
    bindSourceHandlers_name = selector.String
    if bindSourceHandlers_name ~= "" then bindHandler(bindSourceHandlers_name, sourceControls[bindSourceHandlers_name]) end
  end
end

function isSelectableSourceControl(name)
  isSelectableSourceControl_normalizedName = string.lower(tostring(name or ""))
  return not isSelectableSourceControl_normalizedName:match("^log%.")
    and not isSelectableSourceControl_normalizedName:match("^script%.")
    and not (reflectReady and isSelectableSourceControl_normalizedName == "status")
end

function bindSourceComponent()
  releaseSourceHandlers()
  sourceComponent = nil
  sourceControls = {}
  sourceControlNames = { "" }
  sourceStatus = nil
  sourceStatusReadOnly = false
  nativeStatusValue, nativeStatusText = 0, "OK"
  lastDirectStatusValue, lastDirectStatusText = nil, nil

  bindSourceComponent_componentName = runtimeControls.Component.String
  if bindSourceComponent_componentName == "" then
    for index, selector in ipairs(runtimeControls.Control) do
      selector.Choices = sourceControlNames
      runtimeControls.Value[index].String = ""
      setValueColor(runtimeControls.Value[index], COLOR_OK)
    end
    evaluateMonitoring()
    return
  end

  bindSourceComponent_ok, bindSourceComponent_descriptors = pcall(Component.GetControls, bindSourceComponent_componentName)
  if not bindSourceComponent_ok or not bindSourceComponent_descriptors then
    logError("Unable to inspect component '" .. bindSourceComponent_componentName .. "'", bindSourceComponent_descriptors)
    evaluateMonitoring()
    return
  end

  bindSourceComponent_ok, sourceComponent = pcall(Component.New, bindSourceComponent_componentName)
  if not bindSourceComponent_ok or not sourceComponent then
    logError("Unable to connect to component '" .. bindSourceComponent_componentName .. "'", sourceComponent)
    sourceComponent = nil
    evaluateMonitoring()
    return
  end

  for _, descriptor in ipairs(bindSourceComponent_descriptors) do
    bindSourceComponent_name = descriptor.Name
    bindSourceComponent_control = bindSourceComponent_name and sourceComponent[bindSourceComponent_name]
    if bindSourceComponent_name and bindSourceComponent_control then
      if string.lower(bindSourceComponent_name) == "status" then
        sourceStatus = bindSourceComponent_control
        sourceStatusReadOnly = tostring(descriptor.Direction):lower():gsub("[%s%-_]", "") == "readonly"
      end
      if isSelectableSourceControl(bindSourceComponent_name) then
        table.insert(sourceControlNames, bindSourceComponent_name)
        sourceControls[bindSourceComponent_name] = bindSourceComponent_control
      end
    end
  end

  if sourceStatus then
    if sourceStatusReadOnly then
      print("[Monitor Debug] source Status is read-only; " .. (reflectReady
        and "disable Reflect Ready and use a Monitoring Proxy"
        or "source status passthrough is available through the Monitoring Proxy"))
    end
    if reflectReady then
      nativeStatusValue = tonumber(controlValue(sourceStatus)) or 0
      nativeStatusText = controlText(sourceStatus)
    end
    print(string.format(
      "[Monitor Debug] source Status found: value=%s, string=%q",
      tostring(controlValue(sourceStatus)), controlText(sourceStatus)
    ))
  else
    print("[Monitor Debug] source component has no Status control; defaulting to OK")
  end

  table.sort(sourceControlNames, function(a, b)
    return string.lower(a) < string.lower(b)
  end)

  for _, selector in ipairs(runtimeControls.Control) do
    selector.Choices = sourceControlNames
    if selector.String ~= "" and not sourceControls[selector.String] then
      selector.String = ""
    end
  end

  bindSourceHandlers()
  updateDisplayedValues()
  evaluateMonitoring()
end

function bindMonitorComponent()
  if reflectReady then
    evaluateMonitoring()
    return
  end
  if monitorComponent and monitorComponent["status"] then
    pcall(function() monitorComponent["status"].EventHandler = nil end)
  end
  monitorComponent = nil
  bindMonitorComponent_monitorName = runtimeControls.Monitor.String
  if bindMonitorComponent_monitorName == "" then
    evaluateMonitoring()
    return
  end

  bindMonitorComponent_ok, bindMonitorComponent_component = pcall(Component.New, bindMonitorComponent_monitorName)
  if not bindMonitorComponent_ok or not bindMonitorComponent_component then
    logError("Unable to connect to Monitoring Proxy '" .. bindMonitorComponent_monitorName .. "'", bindMonitorComponent_component)
    evaluateMonitoring()
    return
  end

  monitorComponent = bindMonitorComponent_component
  bindMonitorComponent_targetStatus = monitorComponent["status"]
  if bindMonitorComponent_targetStatus then bindMonitorComponent_targetStatus.EventHandler = monitorStatusChanged end
  evaluateMonitoring()
end

function captureBaseline()
  baseline = {}
  reportedChanges = {}
  lockedComponentName = runtimeControls.Component.String
  lockedMonitorName = runtimeControls.Monitor.String

  for index, selector in ipairs(runtimeControls.Control) do
    baseline[index] = {
      name = selector.String,
      value = controlText(sourceControls[selector.String]),
      logEntry = runtimeControls.LogEntry[index].String,
      normalLogEntry = runtimeControls.NormalLogEntry[index].String,
      severity = runtimeControls.Severity[index].String,
      alias = runtimeControls.Alias[index].String
    }
  end
end

function applyLock()
  applyLock_locked = runtimeControls.Lock.Boolean
  runtimeControls.Lock.Color = applyLock_locked and COLOR_LOCKED or COLOR_UNLOCKED
  runtimeControls.Component.IsDisabled = applyLock_locked
  runtimeControls.Monitor.IsDisabled = applyLock_locked
  for _, selector in ipairs(runtimeControls.Control) do
    selector.IsDisabled = applyLock_locked
  end
  for _, logEntry in ipairs(runtimeControls.LogEntry) do
    logEntry.IsDisabled = applyLock_locked or reflectReady
  end
  for _, logEntry in ipairs(runtimeControls.NormalLogEntry) do
    logEntry.IsDisabled = applyLock_locked or reflectReady
  end
  for _, severity in ipairs(runtimeControls.Severity) do
    severity.IsDisabled = applyLock_locked or reflectReady
  end
  for _, alias in ipairs(runtimeControls.Alias) do
    alias.IsDisabled = applyLock_locked
  end
end

function restoreLockedSelection(control, expected)
  if not runtimeControls.Lock.Boolean or control.String == expected then return false end

  changingControl = true
  control.String = expected or ""
  changingControl = false
  return true
end

evaluateMonitoring = function()
  if reflectReady and updatingMonitorStatus then return end
  updateDisplayedValues()

  if not sourceComponent then
    setMonitorStatus(1, "Selected component is unavailable")
    return
  end

  callback_sourceStatusText = "OK"
  if sourceStatus then
    callback_ok, callback_statusValue = pcall(function() return sourceStatus.Value end)
    if not callback_ok then
      setMonitorStatus(1, "Unable to read selected component status")
      return
    end

    callback_sourceStatusText = controlText(sourceStatus)
    callback_statusValue = tonumber(callback_statusValue) or 0
    if reflectReady then
      callback_statusValue = nativeStatusValue
      callback_sourceStatusText = nativeStatusText
    end
    print(string.format(
      "[Monitor Debug] source Status evaluated: value=%s, string=%q",
      tostring(callback_statusValue), callback_sourceStatusText
    ))
    if callback_statusValue ~= 0 then
      -- A source fault takes priority on the Monitoring Proxy, but it must not
      -- erase the last known baseline comparison. Re-evaluate colors when the
      -- source returns to OK.
      setMonitorStatus(callback_statusValue, callback_sourceStatusText, callback_statusValue == 4)
      return
    end
  end

  if not runtimeControls.Lock.Boolean then
    reportedChanges = {}
    for _, output in ipairs(runtimeControls.Value) do setValueColor(output, COLOR_OK) end
    setMonitorStatus(0, callback_sourceStatusText)
    return
  end

  callback_changes = {}
  for index, selector in ipairs(runtimeControls.Control) do
    callback_item = baseline[index] or { name = "", value = "" }
    callback_currentValue = controlText(sourceControls[selector.String])
    callback_changed = selector.String ~= callback_item.name or callback_currentValue ~= callback_item.value

    setValueColor(runtimeControls.Value[index], callback_changed and COLOR_CHANGED or COLOR_OK)

    if callback_changed then
      callback_name = controlDisplayName(index)
      table.insert(callback_changes, string.format("%s: %s -> %s", callback_name, callback_item.value, callback_currentValue))

      if not reportedChanges[index] then
        sendMonitorLog(runtimeControls.LogEntry[index].String, compromisedSeverity(runtimeControls.Severity[index].String))
        reportedChanges[index] = true
      end
    else
      if reportedChanges[index] then
        sendMonitorLog(runtimeControls.NormalLogEntry[index].String, "normal")
      end
      reportedChanges[index] = false
    end
  end

  if #callback_changes > 0 then
    setMonitorStatus(1, "Changed: " .. table.concat(callback_changes, "; "))
  else
    setMonitorStatus(0, callback_sourceStatusText)
  end
end

function componentSelectionChanged()
  if changingControl then return end
  if restoreLockedSelection(runtimeControls.Component, lockedComponentName) then return end
  resetControlSlots()
  bindSourceComponent()
end

function monitorSelectionChanged()
  if changingControl then return end
  if restoreLockedSelection(runtimeControls.Monitor, lockedMonitorName) then return end
  bindMonitorComponent()
end

function selectedControlChanged(index)
  if changingControl then return end

  selectedControlChanged_expected = baseline[index] and baseline[index].name or ""
  if restoreLockedSelection(runtimeControls.Control[index], selectedControlChanged_expected) then
    updateDisplayedValues()
    return
  end

  selectedControlChanged_selectedName = runtimeControls.Control[index].String
  runtimeControls.Alias[index].String = ""
  runtimeControls.NormalLogEntry[index].String = selectedControlChanged_selectedName ~= ""
    and controlDisplayName(index) .. " is back to normal." or ""
  if selectedControlChanged_selectedName == "" then
    runtimeControls.LogEntry[index].String = ""
  else
    runtimeControls.LogEntry[index].String = defaultLogEntry(
      controlDisplayName(index),
      sourceControls[selectedControlChanged_selectedName]
    )
  end
  bindSourceHandlers()
  evaluateMonitoring()
end

function aliasChanged(index)
  if changingControl or runtimeControls.Lock.Boolean then return end

  aliasChanged_selectedName = runtimeControls.Control[index].String
  runtimeControls.NormalLogEntry[index].String = aliasChanged_selectedName ~= ""
    and controlDisplayName(index) .. " is back to normal." or ""
  if aliasChanged_selectedName == "" then
    runtimeControls.LogEntry[index].String = ""
    return
  end

  runtimeControls.LogEntry[index].String = defaultLogEntry(
    controlDisplayName(index),
    sourceControls[aliasChanged_selectedName]
  )
end

function lockChanged()
  applyLock()

  if runtimeControls.Lock.Boolean then
    captureBaseline()
    saveState(true)
  else
    baseline = {}
    reportedChanges = {}
    lockedComponentName = ""
    lockedMonitorName = ""
    saveState(false)
  end

  evaluateMonitoring()
end

function discoverComponents()
  discoverComponents_componentNames = {}
  discoverComponents_monitorNames = {}

  for _, component in ipairs(Component.GetComponents()) do
    if component.Type == "monitoring_proxy" then
      table.insert(discoverComponents_monitorNames, component.Name)
    else
      table.insert(discoverComponents_componentNames, component.Name)
    end
  end

  table.sort(discoverComponents_componentNames, function(a, b) return string.lower(a) < string.lower(b) end)
  table.sort(discoverComponents_monitorNames, function(a, b) return string.lower(a) < string.lower(b) end)
  runtimeControls.Component.Choices = discoverComponents_componentNames
  runtimeControls.Monitor.Choices = discoverComponents_monitorNames
end

discoverComponents()

for index = 1, #runtimeControls.Control do
  runtimeControls.Severity[index].Choices = { "warning", "error" }
  runtimeControls.Severity[index].String = compromisedSeverity(runtimeControls.Severity[index].String)
end

savedState = loadState()
if savedState then
  changingControl = true
  runtimeControls.Lock.Boolean = savedState.locked
  if savedState.locked then
    runtimeControls.Component.String = savedState.component
    runtimeControls.Monitor.String = savedState.monitor
    for index, item in pairs(savedState.slots) do
      if runtimeControls.Control[index] then
        runtimeControls.Control[index].String = item.name
        runtimeControls.Alias[index].String = item.alias or ""
        runtimeControls.LogEntry[index].String = item.logEntry or ""
        runtimeControls.NormalLogEntry[index].String = item.normalLogEntry or ""
        runtimeControls.Severity[index].String = compromisedSeverity(item.severity)
      end
    end
  end
  changingControl = false

  if savedState.locked then
    baseline = savedState.slots
    lockedComponentName = savedState.component
    lockedMonitorName = savedState.monitor
  end
end

bindSourceComponent()

for index, selector in ipairs(runtimeControls.Control) do
  if selector.String ~= "" and runtimeControls.NormalLogEntry[index].String == "" then
    runtimeControls.NormalLogEntry[index].String = controlDisplayName(index) .. " is back to normal."
  end
  if selector.String ~= "" and runtimeControls.LogEntry[index].String == "" then
    runtimeControls.LogEntry[index].String = defaultLogEntry(
      controlDisplayName(index),
      sourceControls[selector.String]
    )
  end
end

bindMonitorComponent()
applyLock()

if not savedState and runtimeControls.Lock.Boolean then
  captureBaseline()
  saveState(true)
end

runtimeControls.Component.EventHandler = componentSelectionChanged
runtimeControls.Monitor.EventHandler = monitorSelectionChanged
runtimeControls.Lock.EventHandler = lockChanged

function bindRowHandlers(controlIndex, selector)
  selector.EventHandler = function()
    selectedControlChanged(controlIndex)
  end
  runtimeControls.Alias[controlIndex].EventHandler = function()
    aliasChanged(controlIndex)
  end
end

for index, selector in ipairs(runtimeControls.Control) do
  bindRowHandlers(index, selector)
end

evaluateMonitoring()

end -- if Controls
